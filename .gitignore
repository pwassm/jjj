# Machine-local ignore rules live in .git/info/exclude, not here.

# Claude
.claude

# jpgs
jpgs

# AHK — the AHK folder and every .ahk anywhere in the repo
AHK
*.ahk

# Backup files
*.bak

# Deleted links archive (kept locally only)
deleted.json

# (dev0550) Cloudflare Worker (worker/) — wrangler local state + deps.
# The source (src/, schema.sql, wrangler.toml, README) IS committed; secrets
# only ever enter via `wrangler secret put`, never files.
worker/.wrangler/
worker/node_modules/

# (dev0312) Local-media IndexedDB exports — privacy.
# Q's index (the localmedia IDB) lives in Chrome's profile, not in this repo:
#   %LOCALAPPDATA%\Google\Chrome\User Data\Default\IndexedDB\http_localhost_8080\
# These ignores are belt-and-suspenders against any future "export IDB to
# JSON" feature dumping into the project root.
q-export*.json
localmedia-export*.json
*.idb.json
*.idb.txt

# (dev0649) Proton VPN WireGuard rotation. The scripts (vpn-rotate*.bat / .ps1)
# ARE committed; the .conf files under vpn-configs/ hold PRIVATE KEYS and the
# staged active tunnel must NEVER be committed. (Runtime state/log live under
# %LOCALAPPDATA%\ProtonVpnRotate, outside the repo.)
vpn-configs/*.conf
# (dev1069) …and in any sub-folder (retired/ parks confs out of the rotation)
vpn-configs/**/*.conf
proton_active.conf

# Logs
logs
*.log
# Rotated logs (the suffix trails the extension)
*.log.[0-9]*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

logo/

# vidtools/ measurement outputs — one per analysed clip, regenerated in ~1 min
# by measure-grid.py. The scripts themselves ARE tracked.
vidtools/*.json

# (dev0853) ml.json is the FULL file and stays LOCAL. The repo is public and
# GitHub Pages serves whatever is committed, so the full ftext - packaged web
# pages, personal notes - must never be in it. save() writes the filtered
# ml.public.json alongside; that one is committed and is what the site fetches.
# Backup for this file is backup-root.ps1, NOT git.
ml.json

# (dev0878) Scratch ftext payloads written into the project root so :8080 can
# serve them to a one-line console apply. Throwaway, never committed.
_uid*.html

__pycache__/

backupdir/
# (dev1034) deshake motion files: written by the analysis pass, dead once the render has run (proxy sweeps them after a day).
.vidstab/
# (dev1178) Merriam-Webster API keys — LOCAL ONLY, never committed. tags.js reads it on localhost.
mw.local.json
